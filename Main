-- === APPENDED SAFETY & SETTINGS INITIALIZATION ===
-- Add new persistent settings and enforce metadata bounds for numeric flags without modifying mechanics.

-- Ensure Aim/AttractionStrength respects configured bounds: base=10, max=1000.
FLAG_METADATA["Aim/AttractionStrength"] = { Min = 10, Max = 1000 }

-- Add new Settings flags (these will be picked up by ConfigManager save/load)
if Flags["Settings/Theme"] == nil then Flags["Settings/Theme"] = "Dark" end
if Flags["Settings/PerformanceMode"] == nil then Flags["Settings/PerformanceMode"] = "Balanced" end
if Flags["Settings/ShowFPS"] == nil then Flags["Settings/ShowFPS"] = false end
if Flags["Settings/Tracking/SamplingRate"] == nil then Flags["Settings/Tracking/SamplingRate"] = 60 end

-- Helper: clamp numeric flags to FLAG_METADATA when applicable
local function clampFlagsToMetadataOnce()
    for k, meta in pairs(FLAG_METADATA) do
        if type(meta) == "table" and (meta.Min or meta.Max) and Flags[k] ~= nil and type(Flags[k]) == "number" then
            local v = Flags[k]
            if meta.Min and v < meta.Min then
                Flags[k] = meta.Min
            end
            if meta.Max and v > meta.Max then
                Flags[k] = meta.Max
            end
        end
    end
end

-- Initial clamp and periodic enforcement (low overhead)
pcall(clampFlagsToMetadataOnce)
task.spawn(function()
    while true do
        task.wait(1)
        pcall(clampFlagsToMetadataOnce)
    end
end)

-- Sanity: ensure default AttractionStrength is within the new bounds
if type(Flags["Aim/AttractionStrength"]) ~= "number" then
    Flags["Aim/AttractionStrength"] = 200
else
    if Flags["Aim/AttractionStrength"] < 10 then Flags["Aim/AttractionStrength"] = 10 end
    if Flags["Aim/AttractionStrength"] > 1000 then Flags["Aim/AttractionStrength"] = 1000 end
end

