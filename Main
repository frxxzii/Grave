-- Startup policy: every optional mechanic begins disabled. Settings/UI remain available.
local STARTUP_MECHANICS_OFF = true
local function ForceMechanicsOff()
    if not STARTUP_MECHANICS_OFF then return end
    local off = {
        "Aim/AimLock", "Aim/AlwaysEnabled", "Aim/ShowAssistDots",
        "ShootBot/Enabled", "ESP/Enabled", "ESP/PlayerOutlines",
        "LocalUI/PerformancePanel", "LocalUI/LocalHealthIndicator",
        "LocalUI/ClosestPlayerTracker", "Br3ak3r/Enabled", "Waypoints/Enabled",
        "Settings/Freecam Toggle", "Settings/GhostMode", "Visuals/Fullbright",
        "Visuals/FullDark", "Visuals/InformationDisplay", "Misc/ScrollUnlocker",
        "Misc/QTeleport", "Misc/ItemPanel"
    }
    for _, key in ipairs(off) do
        if Flags[key] ~= nil and type(Flags[key]) == "boolean" then
            Flags[key] = false
        end
    end
end
ForceMechanicsOff()

